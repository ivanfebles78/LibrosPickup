# Puerto del servidor
PORT=3000
# Número de puestos de atención (1, 2 o 3)
STATIONS=3
# Reservas permitidas por cada franja de 10 minutos
SLOT_CAPACITY=1
# PIN que deben introducir los empleados en /empleado (vacío = sin PIN, solo red local)
STAFF_PIN=
# Nombre del colegio mostrado en las pantallas
SCHOOL_NAME=Centro Educativo Hispano Británico S21

# --- Email (opcional; si no se configura, el código se muestra en consola) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Recogida de libros <no-reply@colegio.es>"

# --- SMS vía Twilio (opcional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
